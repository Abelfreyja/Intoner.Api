<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Authors>abelfreyja</Authors>
    <RepositoryUrl>https://github.com/abelfreyja/Intoner</RepositoryUrl>
    <Description>IPC definitions for Intoner!</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;MA0048</NoWarn>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <Use_Dalamud_ImGui>false</Use_Dalamud_ImGui>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageReference Include="MessagePack.Annotations" Version="3.1.12" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.317" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Intoner" />
    <InternalsVisibleTo Include="Intoner.Api.Verification" />
  </ItemGroup>
</Project>
